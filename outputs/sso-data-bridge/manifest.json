{
  "manifest_version": 3,
  "name": "SSO Data Bridge",
  "version": "1.3.6",
  "description": "复用浏览器 SSO 会话抓取分页接口数据，并提供 JSON 查看、字段建模、筛选与 Dashboard 分析。",
  "minimum_chrome_version": "116",
  "permissions": [
    "clipboardWrite",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "action": {
    "default_title": "打开 SSO Data Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
